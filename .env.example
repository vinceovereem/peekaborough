# Leave these empty to run in demo mode (in-memory data, one-click demo sign-in).
# Fill them in to switch to Supabase + Google sign-in. See README.md, "Going live".

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Google Cloud → APIs & Services → enable "Places API (New)" → create an API key.
# Adds Google ratings, reviews, opening hours and a photo to place pages. Billed by Google per view.
GOOGLE_MAPS_API_KEY=

# Optional: automatic event listings. Free keys from skiddle.com/api/join.php and developer.ticketmaster.com.
SKIDDLE_API_KEY=
TICKETMASTER_API_KEY=
# Any long random string; Vercel sends it with the daily /api/sync cron call.
CRON_SECRET=

# Optional: the "Ask" assistant. Key from console.anthropic.com. Billed per question.
ANTHROPIC_API_KEY=

# Supabase → Project Settings → API keys → Secret key. Server-only: never prefix with NEXT_PUBLIC_.
# Used for the admin back office and photo uploads.
SUPABASE_SECRET_KEY=
